{
  "manifest_version": 3,
  "name": "Slop Guard",
  "version": "1.0.0",
  "description": "A browser companion for defending your attention against engagement-optimized content.",
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "32": "icons/gray.png"
    },
    "default_title": "Slop Guard"
  },
  "icons": {
    "32": "icons/gray.png",
    "48": "icons/gray.png",
    "128": "icons/gray.png"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": false
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "slopguard@slopguard",
      "strict_min_version": "128.0"
    }
  }
}
